{
  "expo": {
    "name": "Calculus Čitač Fiskala",
    "slug": "calculus-citac-fiskala",
    "owner": "nikolacalculusmd",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "calculusqr",
    "userInterfaceStyle": "automatic",
    "description": "Aplikacija za očitanje fiskalnih računa povezana sa Calculus bazom podataka.",
    "primaryColor": "#699cf5",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.calculus.calculuscitacfiskala",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 8,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.calculus.calculuscitacfiskala",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#699cf5",
          "android": {
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dozvolite aplikaciji Calculus pristup kameri radi skeniranja QR kodova i fotografisanja fiskalnih računa za OCR.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dozvolite aplikaciji Calculus pristup izabranim fotografijama fiskalnih računa radi skeniranja QR kodova i prepoznavanja teksta (OCR).",
          "cameraPermission": "Dozvolite aplikaciji Calculus pristup kameri radi fotografisanja fiskalnih računa i prepoznavanja teksta (OCR).",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "locales": {
      "en-US": "./locales/en-US.json",
      "en": "./locales/en.json",
      "sr": "./locales/sr.json",
      "hr": "./locales/hr.json",
      "bs": "./locales/bs.json",
      "sl": "./locales/sl.json",
      "mk": "./locales/mk.json"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0caab71a-4d64-41b0-bef0-4f13c675c7c4"
      }
    }
  }
}
